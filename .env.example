NODE_ENV=production
PORT=4173

# ----------------------------------------------------------------------------
# Gaming mode
# ----------------------------------------------------------------------------
# Keep real-money mode disabled until licensing, KYC/AML, payments, and provider
# contracts are approved. Setting this to anything other than "demo" also
# disables /api/payments/* and makes /api/provider/session require a credential
# and an acknowledged licence before it will do anything.
GAMING_MODE=demo

# Required only when GAMING_MODE is no longer "demo". Name the licence that
# authorises real-money play and the party that holds it. This field exists so
# that going live requires a conscious, written decision rather than a boolean
# flip. Leave it empty for a demo deployment.
RE_ACKNOWLEDGE_LICENCE=

# Set to "true" only when running behind a reverse proxy that sets
# X-Forwarded-For, otherwise rate limiting keys on the proxy address.
TRUST_PROXY=false

# "crypto" (default, unreproducible) or "provably-fair" (replayable receipts).
RNG_MODE=crypto

# At least 32 characters. Required in production unless ALLOW_EPHEMERAL_SECRET
# is "true", which discards all sessions on restart.
SESSION_SECRET=
ALLOW_EPHEMERAL_SECRET=false

# ----------------------------------------------------------------------------
# Ordinary commerce payments (NOT for gambling deposits)
# ----------------------------------------------------------------------------
# These enable /api/payments/intent, which sells a normal product. This is not,
# and must never become, the deposit path for the casino: Stripe prohibits
# online gambling merchants without prior written approval, and wiring this to a
# slot balance would mean operating an unlicensed gambling business.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# A live key is refused unless this is explicitly "true".
ALLOW_LIVE_STRIPE_KEY=false

# ----------------------------------------------------------------------------
# Licensed aggregators (the lawful route to real-money play)
# ----------------------------------------------------------------------------
# Configure only through the VPS secret store or an untracked .env file.
# A key here is a prerequisite, not permission: the aggregator holds the licence,
# the regulated RNG, the KYC/AML programme and the payment institution.
SOFTSWISS_API_KEY=
PRAGMATIC_PLAY_API_KEY=
SOFTGAMINGS_API_KEY=
BETCONSTRUCT_API_KEY=
SLOTEGRATOR_API_KEY=
PROGRESSPLAY_API_KEY=
GAMINGTEC_API_KEY=
WA_TECHNOLOGY_API_KEY=
HUB88_API_KEY=
SLOTMATRIX_API_KEY=
KAMBI_API_KEY=
ZINGY_DESK_API_KEY=
IGAMINGCLOUD_API_KEY=
CXENSE_API_KEY=
